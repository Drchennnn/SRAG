# 应用配置
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
COURSE_ROOT=./courses
DATA_DIR=./data

# DashScope / Qwen：RAG 模型配置
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=20
DASHSCOPE_VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_VISUAL_EMBEDDING_DIMENSION=1024
DASHSCOPE_VISUAL_MAX_IMAGE_BYTES=10485760
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank
DASHSCOPE_OCR_MODEL=
DASHSCOPE_VISION_MODEL=
DASHSCOPE_TIMEOUT_SECONDS=60
DASHSCOPE_MAX_RETRIES=3

# DeepSeek：查询理解、按需改写、多模态问题输入与回答生成
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_QUERY_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3

# Notebook 结构化切块
NOTEBOOK_CHUNK_SOFT_MIN_TOKENS=120
NOTEBOOK_CHUNK_TARGET_TOKENS=280
NOTEBOOK_CHUNK_MAX_TOKENS=450
NOTEBOOK_CHUNK_OVERLAP_TOKENS=40

# 检索配置
RETRIEVAL_TOP_K=8
RETRIEVAL_ENABLE_VISUAL=false
RETRIEVAL_CONTEXT_BUDGET_TOKENS=8000
RETRIEVAL_MAX_NEIGHBOR_CHUNKS=2

# 本地存储
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_chunks
SQLITE_PATH=./data/srag.sqlite3
