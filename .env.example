# 应用与本地数据目录（零 Docker 默认即可运行）
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
COURSE_ROOT=./examples/demo-course
DATA_DIR=./data/demo-workspace
SQLITE_PATH=./data/demo-workspace/srag.sqlite3

# 课程工作区授权与模型开关（设为 false 时可纯离线浏览、搜索原文、看原件与图谱导航）
WORKSPACE_COURSE_IDS=demo-course
WORKSPACE_ANSWER_ENABLED=false
WORKSPACE_INPUT_TOKEN_LIMIT=32768

# 检索策略与预算控制
# 可选 9 项：fts | s0 | bilingual | expanded | s2a | s2b | jev | s2a_jev | vector
# J03 定型建议：日常默认推荐 s0；jev / expanded / s2a_jev 本版保持关闭；
# 启用 S3 纯图与语义向量增强时，必须同时设置 WORKSPACE_RETRIEVAL_STRATEGY=vector 与 WORKSPACE_VECTOR_RETRIEVAL_ENABLED=true
WORKSPACE_RETRIEVAL_STRATEGY=s0
WORKSPACE_RETRIEVAL_POOL_CAP=12
# 0 表示由策略决定默认预算；设为 6 可对齐多策略同预算 6 槽契约
WORKSPACE_RETRIEVAL_BUDGET=6
WORKSPACE_RETRIEVAL_INCLUDE_ADJACENCY=true

# H 部：单课程可溯源知识图谱（#kg-panel 与消息概念芯片双入口默认启用，零外部调用；问答一跳候选增强默认关闭）
WORKSPACE_KG_RETRIEVAL_ENABLED=false

# S3 可选向量与纯图增强（默认关闭；启用需同时设 WORKSPACE_RETRIEVAL_STRATEGY=vector + WORKSPACE_VECTOR_RETRIEVAL_ENABLED=true）
WORKSPACE_VECTOR_RETRIEVAL_ENABLED=false
QDRANT_LOCAL_PATH=
WORKSPACE_S3_MAX_VISUAL_READS=2

# LibreOffice 可执行文件路径（用于 PPTX 整页与裁图渲染；留空时自动检测 PATH / 标准安装路径，缺失则回退原生文本）
SRAG_SOFFICE=
SOURCE_EVIDENCE_COURSE_IDS=demo-course

# DeepSeek：按需双语改写、S2b 规划与中文综合回答生成（仅后端读取，开启 WORKSPACE_ANSWER_ENABLED=true 时生效）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_QUERY_MODEL=deepseek-flash
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=3
# 0 自动使用官方已知窗口，未知模型保守按 16384。自定义端点可填写实际窗口。
DEEPSEEK_CONTEXT_TOKENS=0

# DashScope / Qwen：按需定向读图与可选 S3 Embedding / 旧版 Rerank
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# 当前版原件入口及工作区按需视觉读取需显式启用
SOURCE_VISION_ENABLED=false
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding
DASHSCOPE_EMBEDDING_DIMENSION=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=20
DASHSCOPE_VISUAL_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_VISUAL_EMBEDDING_DIMENSION=1024
DASHSCOPE_VISUAL_MAX_IMAGE_BYTES=10485760
DASHSCOPE_RERANK_MODEL=qwen3.7-text-rerank
DASHSCOPE_TIMEOUT_SECONDS=60
DASHSCOPE_MAX_RETRIES=3

# Jev 证据评分（J03 实测远程 RTT 过高，本版默认关闭；仅保留复测入口）
JEV_BASE_URL=https://api.zleap.com/v1
JEV_MODEL=Zev-1
JEV_API_KEY=
JEV_TIMEOUT_SECONDS=15
JEV_MAX_RETRIES=1

# Notebook 与 PDF/PPTX 本地解析切块参数
NOTEBOOK_CHUNK_SOFT_MIN_TOKENS=120
NOTEBOOK_CHUNK_TARGET_TOKENS=280
NOTEBOOK_CHUNK_MAX_TOKENS=450
NOTEBOOK_CHUNK_OVERLAP_TOKENS=40
SLIDE_CHUNK_MAX_TOKENS=650
SLIDE_CHUNK_OVERLAP_TOKENS=50
# 本地默认关闭；可用 python -m tools.workspace_reading ocr 对已发布扫描 PDF 显式增强
SLIDE_PDF_ENABLE_OCR_FALLBACK=false
SLIDE_PDF_OCR_MIN_TEXT_TOKENS=8
SLIDE_PPTX_RENDER_SLIDES=true
RETRIEVAL_ENABLE_VISUAL=true

# 旧版 HTTP/CLI 向量检索与外部 Qdrant（默认无需 Docker）
RAG_SEARCH_BACKEND=local
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=course_chunks
